# Prop Layer — operator environment (variable NAMES only; never commit values).
#
# Copy to .env, fill it in, and keep it out of git: .gitignore already ignores .env, and
# `npm run check:config` fails if it is ever tracked or if a value leaks into another file.
#
# Nothing here is needed to work on the website or to run the test suites. These are only
# for deploying the backend and setting up billing.
#
#   cp .env.example .env
#   npm run backend:deploy -- --write-config
#   npm run billing:setup -- --price-cents 1499
#   npm run e2e:billing

# ---------------------------------------------------------------- Supabase (deploy)
# Personal access token: Dashboard → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
# The 20-character project ref from the project URL.
SUPABASE_PROJECT_REF=
# Database password, chosen when the project was created.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------- Supabase (e2e only)
# Defaults to https://$SUPABASE_PROJECT_REF.supabase.co when left empty.
SUPABASE_URL=
# Service-role / secret key: Dashboard → Project Settings → API keys. Server-side only —
# it bypasses Row Level Security and must never reach a browser or a desktop binary.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_…) or the legacy anon key. Public by design.
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- Stripe
# sk_test_… while testing. The scripts refuse an sk_live_ key unless --allow-live is given,
# and `npm run e2e:billing` refuses a live key outright.
STRIPE_SECRET_KEY=
# Set automatically by `npm run billing:setup` when it creates the webhook endpoint.
# Stripe shows a signing secret only once, at creation.
STRIPE_WEBHOOK_SECRET=
# Price in minor units for billing:setup, e.g. 1499 for $14.99.
PRICE_CENTS=

# ---------------------------------------------------------------- Edge Function settings
# All optional; the defaults in supabase/functions/_shared/env.ts match the contract.
# STRIPE_PRICE_LOOKUP_KEY        default proplayer_monthly
# STRIPE_PORTAL_CONFIGURATION_ID set by billing:setup
# STRIPE_AUTOMATIC_TAX           default false; true needs Stripe Tax activated
# SITE_URL                       default https://prop-layer.com
# ALLOWED_ORIGINS                default https://prop-layer.com,http://localhost:4173
# ENTITLEMENT_RECHECK_SECONDS    default 3600 (contract range 300–86400)
# OFFLINE_GRACE_SECONDS          default 259200 (contract range 0–604800)
# PAST_DUE_ENTITLED              default true
STRIPE_PRICE_LOOKUP_KEY=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_AUTOMATIC_TAX=
SITE_URL=
ALLOWED_ORIGINS=
ENTITLEMENT_RECHECK_SECONDS=
OFFLINE_GRACE_SECONDS=
PAST_DUE_ENTITLED=

# ---------------------------------------------------------------- Email (SMTP)
# Supabase's built-in email only reaches team members and is heavily rate-limited, so a
# real SMTP provider is required before launch. backend:deploy applies these only when
# HOST, PORT, USER, PASS and SENDER_EMAIL are all set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
# Optional; defaults to SMTP_SENDER_EMAIL.
SMTP_ADMIN_EMAIL=

# ---------------------------------------------------------------- Local test overrides
# PLAYWRIGHT_CHANNEL   default "chrome"; set to "chromium" to use Playwright's bundled build
# DATABASE_URL         a PostgreSQL 15+ instance for `npm run test:db:psql`
# PG_BIN               a directory with initdb and postgres, to spin up a throwaway cluster
PLAYWRIGHT_CHANNEL=
DATABASE_URL=
PG_BIN=
